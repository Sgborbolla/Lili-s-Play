<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { title: 'Ingresar · Panel', themeColor: '#f6f8fc', pageCss: ['/css/admin.css?v=8', '/css/watermarks.css?v=2'], robots: 'noindex,nofollow,noarchive' }) %>
</head>
<body class="login-body" id="top">
<%- include('../partials/watermarks', { watermarkClass: 'watermarks--admin' }) %>

<div class="login-wrap">
  <section class="login-brand">
    <%- include('../partials/brand', { brandHref: '/' }) %>
    <div>
      <h2>Modo<br><span>administrador</span></h2>
      <p>Pedidos, productos, precios y ajustes del salón. Esta zona es solo para el personal de Lily's Plays.</p>
    </div>
    <span class="login-symbols" aria-hidden="true"><span>△</span><span>○</span><span>✕</span><span>□</span></span>
  </section>

  <section class="login-form">
    <p class="eyebrow" style="margin-bottom: 6px;">Acceso privado</p>
    <h1>Entrar al panel</h1>
    <p class="lead">Usa tu usuario y contraseña de administrador. Los clientes nunca ven esta página.</p>

    <% if (error) { %>
    <div class="alert alert-err" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/admin/login" autocomplete="on">
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label for="username">Usuario</label>
        <input id="username" name="username" type="text" value="<%= username %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>

      <button class="btn btn-primary" type="submit">Entrar al panel</button>
    </form>

    <p class="login-back"><a href="/">← Volver al menú público</a></p>
  </section>
</div>

<footer class="admin-foot admin-foot--login">
  <p class="legal">
    <span><%= settings.footer_credit %></span>
    <a href="#top">Volver arriba</a>
  </p>
</footer>

<script src="/js/admin.js"></script>
</body>
</html>

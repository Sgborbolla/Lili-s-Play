<%- include('../partials/admin-top', { title: 'Resumen', active: 'dashboard' }) %>

<section class="stat-grid" aria-label="Indicadores de hoy">
  <article class="stat-card" style="--accent: #006fcd">
    <span class="stat-label">Pedidos de hoy</span>
    <strong class="stat-value"><%= stats.todayOrders %></strong>
    <span class="stat-sub">Órdenes registradas</span>
  </article>
  <article class="stat-card" style="--accent: #ff3c28">
    <span class="stat-label">Pendientes</span>
    <strong class="stat-value"><%= stats.pending %></strong>
    <span class="stat-sub">Nuevos, preparando o listos</span>
  </article>
  <article class="stat-card" style="--accent: #107c10">
    <span class="stat-label">Ingresos de hoy</span>
    <strong class="stat-value" style="font-size: 24px;"><%= money(stats.todayRevenue) %></strong>
    <span class="stat-sub">Sin pedidos cancelados</span>
  </article>
  <article class="stat-card" style="--accent: #7928ca">
    <span class="stat-label">Productos activos</span>
    <strong class="stat-value"><%= stats.activeProducts %></strong>
    <span class="stat-sub">Disponibles en el menú</span>
  </article>
</section>

<div class="panel-grid">
  <section class="card">
    <div class="card-head">
      <h2>Últimos pedidos</h2>
      <a class="btn btn-ghost btn-sm card-action" href="/admin/pedidos">Ver todos →</a>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Estación</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% if (!recent.length) { %>
          <tr><td class="cell-empty" colspan="5">Todavía no hay pedidos. Cuando llegue el primero, aparece aquí.</td></tr>
          <% } %>
          <% recent.forEach((order) => { const meta = statusMeta(order.status); %>
          <tr>
            <td>
              <span class="cell-name"><%= order.code %></span>
              <span class="cell-sub"><%= fmtDate(order.created_at) %></span>
            </td>
            <td class="num">#<%= order.station %></td>
            <td><%= order.customer || '—' %></td>
            <td class="num"><%= money(order.total_cents) %></td>
            <td><span class="badge tone-<%= meta.tone %>"><%= meta.label %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <aside class="card">
    <div class="card-head"><h2>Accesos rápidos</h2></div>
    <div class="card-body">
      <div class="quick-actions">
        <a class="quick-action" href="/admin/pedidos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h10a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1Z"/><path d="M9.5 8h5M9.5 12h5"/></svg>
          Ver pedidos
        </a>
        <a class="quick-action" href="/admin/productos/nuevo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo producto
        </a>
        <a class="quick-action" href="/admin/ajustes">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3.1"/><path d="M12 2.6v2.8M12 18.6v2.8M2.6 12h2.8M18.6 12h2.8M5.4 5.4l2 2M16.6 16.6l2 2M18.6 5.4l-2 2M7.4 16.6l-2 2"/></svg>
          Cambiar ajustes
        </a>
        <a class="quick-action" href="/admin/qr">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><path d="M14 14h3v3h-3z"/></svg>
          Ver códigos QR
        </a>
      </div>

      <div class="side-note" style="margin-top: 13px;">
        <b>Panel privado</b>
        Esta zona no aparece en el menú público ni en los códigos QR que escanean los clientes.
      </div>
    </div>
  </aside>
</div>

<%- include('../partials/admin-bottom') %>

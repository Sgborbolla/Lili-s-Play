<%
  const waRaw = String(settings.social_whatsapp || '').trim();
  const fbRaw = String(settings.social_facebook || '').trim();
  const igRaw = String(settings.social_instagram || '').trim();
  const mailRaw = String(settings.social_email || '').trim();
  const ytRaw = String(settings.social_youtube || '').trim();
  const waHref = waRaw ? (/^https?:\/\//i.test(waRaw) ? waRaw : `https://wa.me/${waRaw.replace(/\D/g, '')}`) : '';
  const fbHref = fbRaw ? (/^https?:\/\//i.test(fbRaw) ? fbRaw : `https://${fbRaw}`) : '';
  const igHref = igRaw ? (/^https?:\/\//i.test(igRaw) ? igRaw : `https://${igRaw}`) : '';
  const mailHref = mailRaw ? (/^mailto:/i.test(mailRaw) ? mailRaw : `mailto:${mailRaw}`) : '';
  const ytHref = ytRaw ? (/^https?:\/\//i.test(ytRaw) ? ytRaw : (/^(www\.)?(youtube\.com|youtu\.be)/i.test(ytRaw) ? `https://${ytRaw}` : `https://youtube.com/@${ytRaw.replace(/^@/, '')}`)) : '';
  const hasSocial = waHref || fbHref || igHref || mailHref || ytHref;
%>
<% if (hasSocial) { %>
<div class="socials" aria-label="Redes sociales">
  <% if (waHref) { %>
  <div class="social-item" style="--brand:#25D366">
    <a class="social-btn" href="<%= waHref %>" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 76 76" aria-hidden="true">
        <path class="social-shape" d="M38 8 L69 59 Q71 63 66.5 63 H9.5 Q5 63 7 59 Z"/>
        <circle class="social-disc" cx="38" cy="41" r="13.5"/>
        <g transform="translate(26.7 29.7) scale(0.94)">
          <path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </g>
      </svg>
    </a>
    <span class="social-label">WhatsApp</span>
  </div>
  <% } %>
  <% if (fbHref) { %>
  <div class="social-item" style="--brand:#1877F2">
    <a class="social-btn" href="<%= fbHref %>" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
      <svg viewBox="0 0 76 76" aria-hidden="true">
        <rect class="social-shape" x="7" y="7" width="62" height="62" rx="16"/>
        <circle class="social-disc" cx="38" cy="38" r="14"/>
        <path fill="#1877F2" d="M13.6 21.5v-8.2h2.8l.4-3.2h-3.2V8c0-.9.3-1.6 1.6-1.6h1.7V3.5c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4v3.2h2.8v8.2h3.4z" transform="translate(23.5 23.1) scale(1.2)"/>
      </svg>
    </a>
    <span class="social-label">Facebook</span>
  </div>
  <% } %>
  <% if (igHref) { %>
  <div class="social-item" style="--brand:#DD2A7B">
    <a class="social-btn" href="<%= igHref %>" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
      <svg viewBox="0 0 76 76" aria-hidden="true">
        <defs><linearGradient id="igp" x1="10" y1="10" x2="66" y2="66" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#F58529"/><stop offset=".5" stop-color="#DD2A7B"/><stop offset="1" stop-color="#8134AF"/></linearGradient></defs>
        <circle class="social-shape" cx="38" cy="38" r="30" style="stroke:url(#igp)"/>
        <circle class="social-disc" cx="38" cy="38" r="14"/>
        <rect x="27" y="27" width="22" height="22" rx="6.5" fill="none" stroke="url(#igp)" stroke-width="3.2"/>
        <circle cx="38" cy="38" r="5.6" fill="none" stroke="url(#igp)" stroke-width="3.2"/>
        <circle cx="45.5" cy="30.5" r="1.9" fill="url(#igp)"/>
      </svg>
    </a>
    <span class="social-label">Instagram</span>
  </div>
  <% } %>
  <% if (mailHref) { %>
  <div class="social-item" style="--brand:#EA4335">
    <a class="social-btn" href="<%= mailHref %>" aria-label="Gmail" title="Gmail">
      <svg viewBox="0 0 76 76" aria-hidden="true">
        <path class="social-shape" d="M13 13 L63 63 M63 13 L13 63" stroke-width="5.4"/>
        <circle class="social-disc" cx="38" cy="38" r="13"/>
        <g transform="translate(29 32)">
          <rect x="0" y="0" width="18" height="12" rx="2.5" fill="none" stroke="#EA4335" stroke-width="2.8" stroke-linejoin="round"/>
          <path d="M2 2.5 L9 8 L16 2.5" fill="none" stroke="#EA4335" stroke-width="2.8" stroke-linejoin="round" stroke-linecap="round"/>
        </g>
      </svg>
    </a>
    <span class="social-label">Gmail</span>
  </div>
  <% } %>
  <% if (ytHref) { %>
  <!-- Consola de referencia para el acceso a YouTube -->
  <div class="social-item social-item--ps5" style="--brand:#FF0000">
    <a class="social-btn social-btn--ps5" href="<%= ytHref %>" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
      <img src="/social-ps5.png" alt="Consola PlayStation" loading="lazy">
      <span class="yt-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="#fff"/></svg></span>
    </a>
    <span class="social-label">YouTube</span>
  </div>
  <% } %>
</div>
<% } %>
